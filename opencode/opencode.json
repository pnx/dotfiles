{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "OpenCoder",
  "agent": {
    "build": {
      "disable": true,
    },
    "plan": {
      "disable": true,
    },
    "OpenCoder": {
      "color": "primary",
    },
    "OpenAgent": {
      "color": "secondary",
    },
  },
  "mcp": { },
  "permission": {
    "bash": {
      "*": "ask",
      "php": "allow",
      "php *": "allow",
      "cat": "allow",
      "cat *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "git": "allow",
      "git *": "allow",
      "git push": "deny",
      "git push *": "deny"
    },
    "read": {
      "*": "ask",
      "~/.config/opencode": "allow",
      "~/.config/opencode/**": "allow"
    },
    "external_directory": {
      "*": "ask",
      "~/.config/opencode": "allow",
      "~/.config/opencode/**": "allow"
    }
  }
}
