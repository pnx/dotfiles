{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "OpenCoder",
  "agent": {
    "build": {
      "disable": true,
    },
    "plan": {
      "disable": true,
    },
    "OpenCoder": {
      "color": "primary",
    },
    "OpenAgent": {
      "color": "secondary",
    },
  },
  "mcp": {
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true
    }
  }
}
