{
  "extends": "default-local",
  "meta": {
    "name": "docker-dev"
    "version": "1.0.0",
    "description": "Docker development profile",
    "author": "Henrik Hautakoski"
  },
  "linux": {
    "af_unix_mediation": "pathname"
  },
  "command_policies": {
    "commands": {
      "docker": {
        "from": {
          "session": {
            "sandbox": {
              "fs_read": ["."],
              "unix_socket_bind": [
                "/run/docker.sock",
                "/run/run/docker.sock"
              ]
            },
            "invocation_policy": {
              "default": "deny",
              "allow": [
                {
                  "argv": {
                    "exact": ["ps"]
                  }
                },
                {
                  "argv": {
                    "exact": ["compose", "ps"]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
