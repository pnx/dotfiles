{
  "extends": [
    "default"
  ],
  "meta": {
    "name": "default-local",
    "version": "1.0.0",
    "description": "Local defaults",
    "author": "Henrik Hautakoski"
  },
  "security": {
    "signal_mode": null,
    "process_info_mode": null,
    "ipc_mode": null,
    "capability_elevation": null,
    "approval_backends": {},
    "approval_defaults": null,
    "wsl2_proxy_policy": null
  },
  "groups": {
    "include": [],
    "exclude": []
  },
  "commands": {
    "allow": [],
    "deny": []
  },
  "filesystem": {
    "allow": [],
    "read": [],
    "write": [],
    "allow_file": [],
    "read_file": [],
    "write_file": [],
    "unix_socket": [],
    "unix_socket_bind": [],
    "unix_socket_dir": [],
    "unix_socket_dir_bind": [],
    "unix_socket_subtree": [],
    "unix_socket_subtree_bind": [],
    "deny": [
      "/home/pnx/.ssh",
      "/home/pnx/.aws",
      "/home/pnx/.gnupg",
      "/home/pnx/.docker",
      "/home/pnx/.local/share/keyrings"
    ],
    "bypass_protection": [],
    "suppress_save_prompt": [
      "~/.docker",
      "///var/run/docker.sock",
      "/run/docker.sock"
    ]
  },
  "network": {
    "block": false,
    "allow_http2": false,
    "allow_domain": [],
    "deny_domain": [],
    "open_port": [],
    "open_port_range": [],
    "listen_port": [],
    "listen_port_range": [],
    "connect_port": [],
    "no_proxy": [],
    "custom_credentials": {},
    "tls_intercept": null,
    "upstream_proxy": null,
    "upstream_bypass": [],
    "approval_backends": {},
    "approval_defaults": null
  },
  "diagnostics": {
    "suppress_system_services": [],
    "redaction": {
      "extra_env_vars": []
    },
    "network_denial_audit": {}
  },
  "linux": {
    "af_unix_mediation": "pathname",
    "sandbox_policy": null
  },
  "env_credentials": {},
  "credential_capture": {},
  "credential_providers": {},
  "credential_routes": [],
  "workdir": {
    "access": "readwrite"
  },
  "hooks": {},
  "session_hooks": {},
  "rollback": {
    "exclude_patterns": [],
    "exclude_globs": []
  },
  "skipdirs": [],
  "packs": [],
  "command_args": [],
  "unsafe_macos_seatbelt_rules": []
